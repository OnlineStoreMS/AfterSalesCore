{
  "manifest_version": 3,
  "name": "OSMS 抖店售后工作台",
  "version": "1.2.34",
  "description": "采集抖店售后工作台与退回件，同步到售后管理。",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://fxg.jinritemai.com/*",
    "https://*.jinritemai.com/*",
    "https://osms.zfcycle.com/*",
    "https://*.zfcycle.com/*",
    "http://localhost:5176/*",
    "http://127.0.0.1:5176/*",
    "http://localhost:8093/*",
    "http://127.0.0.1:8093/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "OSMS 抖店售后工作台",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fxg.jinritemai.com/ffa/*"
      ],
      "js": ["content/menu.js", "content/panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fxg.jinritemai.com/ffa/merchant-aftersale-workbench/*"
      ],
      "js": ["content/workbench.js"],
      "run_at": "document_idle"
    }
  ]
}
