{
  "manifest_version": 3,
  "name": "OSMS 抖店售后【诊断】",
  "version": "0.1.0",
  "description": "临时诊断版：手动同步并上报过程日志。不要和生产插件同时当作日常使用。",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://fxg.jinritemai.com/*",
    "https://*.jinritemai.com/*",
    "https://osms.zfcycle.com/*",
    "https://*.zfcycle.com/*",
    "http://localhost:5176/*",
    "http://127.0.0.1:5176/*",
    "http://localhost:8093/*",
    "http://127.0.0.1:8093/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "OSMS 抖店售后【诊断】",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fxg.jinritemai.com/ffa/*"],
      "js": ["content/menu.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fxg.jinritemai.com/ffa/merchant-aftersale-workbench/*"],
      "js": ["content/workbench.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fxg.jinritemai.com/ffa/task-order/service*"],
      "js": ["content/service-order.js"],
      "run_at": "document_idle"
    }
  ]
}
